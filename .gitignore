# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-out.log
dev-err.log
*.log

# temp/scratch files
*.tmp
_tmp_*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local MCP server config -- may contain personal access tokens (e.g. the
# Supabase management token); never meant to be shared via the repo
.mcp.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local report scratch files
report-appendix-code.txt
report-project-facts.txt
