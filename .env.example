# DigiKavach environment variables. Copy to .env.local and fill in.
# NEXT_PUBLIC_* values are bundled into the browser and are safe to be public.
# Everything else is SECRET: never commit it, never expose it client-side.

# --- Public (safe) ---
# Supabase project URL (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon/publishable key (protected by RLS policies in supabase/schema.sql)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Secret ---
# Google Gemini API key (primary LLM for extraction and chat)
GEMINI_API_KEY=
# Groq API key (fallback LLM and vision)
GROQ_API_KEY=

# --- Optional model overrides (not secret; defaults are built in) ---
GEMINI_MODEL=
GROQ_MODEL=
GROQ_VISION_MODEL=

# --- Secret, local scripts only (do NOT add to Vercel) ---
# Only needed temporarily by scripts/regeocode-complaints.mjs
SUPABASE_SERVICE_ROLE_KEY=
